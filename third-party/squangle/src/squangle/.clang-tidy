# NOTE there must be no spaces before the '-', so put the comma after.
# When making changes, be sure to verify the output of the following command to ensure
# the desired checks are enabled (run from the directory containing a .clang-tidy file):
# ~/fbsource/tools/lint/clangtidy/clang-tidy-platform010-clang-21 -list-checks
# NOTE: Please don't disable inheritance from the parent to make sure that common checks get propagated.
#
---
InheritParentConfig: true
Checks: '
bugprone-exception-escape,
bugprone-unchecked-optional-access,
facebook-hte-CheckMacroUse,
facebook-hte-LogFatalUsage,
bugprone-narrowing-conversions,
'
CheckOptions:
  bugprone-narrowing-conversions.WarnOnFloatingPointNarrowingConversion: false
  bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion: false
  bugprone-narrowing-conversions.WarnOnEquivalentBitWidth: false
...
