opts =
  -vEval.ClassAsStringVarDump=false
  -vEval.ClassAsStringVarExport=false
  -vEval.RaiseClassConversionNoticeSampleRate=1
  -vEval.ClassStringHintNoticesSampleRate=1
  -vEval.RaiseStrToClsConversionNoticeSampleRate=1
  -vEval.ClassnameNoticesSampleRate=1
  -vEval.ClassNoticesSampleRate=1
  -vEval.DynamicallyReferencedNoticeSampleRate=1
  -vEval.DynamicClsMethLevel=1
  -vHack.Lang.AllowUnstableFeatures=1
hphp_opts =
  -vRuntime.Eval.RaiseClassConversionNoticeSampleRate=1
  -vRuntime.Eval.ClassStringHintNoticesSampleRate=1
  -vRuntime.Eval.DynamicallyReferencedNoticeSampleRate=1
  -vRuntime.Hack.Lang.AllowUnstableFeatures=true
