opts = -vEval.AssemblerMaxScalarSize=100000
hphp_opts = -vRuntime.Eval.AssemblerMaxScalarSize=100000
hhbbc_opts =
  # Blank hhbbc_opts to prevent this test from running in repo-separate mode (the assertion checked by repo_expect = hhbbc triggers during initial assembly only)
nodumphhas = true
