opts =
  -v watchman.enable=true
  -vEval.EnableArgsInBacktraces=1
hphp_opts =
  --inputs=__DIR__/callback.inc
  --inputs=__DIR__/constants.inc
  --inputs=__DIR__/wminst.inc
  -vRuntime.Eval.EnableArgsInBacktraces=1
norepo = true
nomultireq = true
onlyfacebook = true
; Depends on watchman binary being present on host
no_remote = true
runif = extension watchman
