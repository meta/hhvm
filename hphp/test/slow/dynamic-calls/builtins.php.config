opts =
  -vEval.NoticeOnBuiltinDynamicCalls=1
  -vEval.ForbidDynamicCallsToFunc=1
  -vEval.ForbidDynamicCallsToInstMeth=1
  -vEval.ForbidDynamicCallsToClsMeth=1
  -vEval.ForbidDynamicConstructs=1
hphp_opts = -vRuntime.Eval.NoticeOnBuiltinDynamicCalls=1 -vRuntime.Eval.ForbidDynamicCallsToFunc=1 -vRuntime.Eval.ForbidDynamicCallsToInstMeth=1 -vRuntime.Eval.ForbidDynamicCallsToClsMeth=1 -vRuntime.Eval.ForbidDynamicConstructs=1 -d hhvm.php7.all=0
